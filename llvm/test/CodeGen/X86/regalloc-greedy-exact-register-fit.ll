  %i = phi i32 [ 0, %entry ], [ %inext, %loop ]
  %v0 = phi <16 x i32> [ zeroinitializer, %entry ], [ %vn0, %loop ]
  %v1 = phi <16 x i32> [ zeroinitializer, %entry ], [ %vn1, %loop ]
  %v2 = phi <16 x i32> [ zeroinitializer, %entry ], [ %vn2, %loop ]
