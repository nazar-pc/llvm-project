; RUN: llc -O3 -mcpu=znver4 < %s | FileCheck %s
; RUN: llc -O3 -mcpu=znver4 -greedy-local-range-block-coverage=0 < %s | \
; RUN:   FileCheck %s --check-prefix=LENGTH-ONLY

; An ARX-style SIMD kernel of the shape used by BLAKE3, BLAKE2 and ChaCha20.
; The loop body keeps exactly 16 accumulators and 16 message vectors live,
; filling zmm0-31 exactly. A spill-free allocation exists, and greedy finds it
; by assigning the single-block live ranges in linear order.
;
; When the "giant local range" test in DefaultPriorityAdvisor::getPriority()
; looks at range length alone, the medium-length ranges in this ~800
; instruction block are pulled out of that order, the assignment fragments,
; and the whole message array ends up spilled.

target triple = "x86_64-unknown-linux-gnu"

; CHECK-LABEL: kernel:
; CHECK-NOT: -byte Spill
; CHECK-NOT: -byte Reload
; CHECK-NOT: %rsp
;
; LENGTH-ONLY-LABEL: kernel:
; LENGTH-ONLY: -byte Spill

