latch:
  %n.next = phi i64 [ %inc, %then ], [ %n, %header ]
  %cont = call i1 @cond()
  br i1 %cont, label %header, label %exit

exit:
  ret void
}

; Negative test: the bound is defined after the loop, in terms of a value that
; changes in each iteration.
define i1 @bound_defined_after_loop() {
; CHECK-LABEL: define i1 @bound_defined_after_loop() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[PN:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[PN_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[OTHER:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[OTHER_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[SMALL:%.*]] = icmp ult i64 [[OTHER]], 100
; CHECK-NEXT:    call void @llvm.assume(i1 [[SMALL]])
; CHECK-NEXT:    [[C_0:%.*]] = icmp ule i64 [[PN]], [[OTHER]]
; CHECK-NEXT:    call void @use(i1 [[C_0]])
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[LATCH]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[PN_NEXT]] = phi i64 [ [[OTHER]], %[[THEN]] ], [ [[PN]], %[[HEADER]] ]
; CHECK-NEXT:    [[OTHER_NEXT]] = call i64 @get()
; CHECK-NEXT:    [[CONT:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[CONT]], label %[[HEADER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[B:%.*]] = add nuw nsw i64 [[OTHER]], 1
; CHECK-NEXT:    [[R:%.*]] = icmp ult i64 [[PN]], [[B]]
; CHECK-NEXT:    ret i1 [[R]]
;
entry:
  br label %header

header:
  %pn = phi i64 [ 0, %entry ], [ %pn.next, %latch ]
  %other = phi i64 [ 1, %entry ], [ %other.next, %latch ]
  %small = icmp ult i64 %other, 100
  call void @llvm.assume(i1 %small)
  %c.0 = icmp ule i64 %pn, %other
  call void @use(i1 %c.0)
  %c = call i1 @cond()
  br i1 %c, label %then, label %latch

then:
  br label %latch

latch:
  %pn.next = phi i64 [ %other, %then ], [ %pn, %header ]
  %other.next = call i64 @get()
  %cont = call i1 @cond()
  br i1 %cont, label %header, label %exit

exit:
  %b = add nuw i64 %other, 1
  %r = icmp ult i64 %pn, %b
  ret i1 %r
}

; Make sure compares in unreachable code are not used as bounds.
define void @bound_in_unreachable_block() {
; CHECK-LABEL: define void @bound_in_unreachable_block() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[N:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[N_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[LATCH]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[INC:%.*]] = add nuw i64 [[N]], 1
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[N_NEXT]] = phi i64 [ [[INC]], %[[THEN]] ], [ [[N]], %[[HEADER]] ]
; CHECK-NEXT:    [[CONT:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[CONT]], label %[[HEADER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
; CHECK:       [[DEAD:.*]]:
; CHECK-NEXT:    [[B:%.*]] = add nuw i64 [[B]], 1
; CHECK-NEXT:    [[R:%.*]] = icmp ult i64 [[N]], [[B]]
; CHECK-NEXT:    br label %[[DEAD]]
;
entry:
  br label %header

header:
  %n = phi i64 [ 0, %entry ], [ %n.next, %latch ]
  %c = call i1 @cond()
  br i1 %c, label %then, label %latch

then:
  %inc = add nuw i64 %n, 1
  br label %latch

latch:
  %n.next = phi i64 [ %inc, %then ], [ %n, %header ]
  %cont = call i1 @cond()
  br i1 %cont, label %header, label %exit

exit:
  ret void

dead:
  %b = add nuw i64 %b, 1
  %r = icmp ult i64 %n, %b
  br label %dead
}

