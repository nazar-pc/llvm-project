; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[N:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[N_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[IV]], [[LEN]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT_CHECK:.*]], label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[C_GEP:%.*]] = getelementptr inbounds nuw i8, ptr [[C]], i64 [[IV]]
; CHECK-NEXT:    [[C_V:%.*]] = load i1, ptr [[C_GEP]], align 1
; CHECK-NEXT:    br i1 [[C_V]], label %[[CHECK:.*]], label %[[LATCH]]
; CHECK:       [[CHECK]]:
; CHECK-NEXT:    br i1 true, label %[[THEN:.*]], label %[[TRAP:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw i32, ptr [[OUT]], i64 [[N]]
; CHECK-NEXT:    store i32 1, ptr [[GEP]], align 4
; CHECK-NEXT:    [[INC:%.*]] = add nuw nsw i64 [[N]], 1
; CHECK-NEXT:    [[FULL:%.*]] = icmp eq i64 [[INC]], 1000
; CHECK-NEXT:    br i1 [[FULL]], label %[[EXIT:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[N_NEXT]] = phi i64 [ [[INC]], %[[THEN]] ], [ [[N]], %[[BODY]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i64 [[IV]], 1
; CHECK-NEXT:    br label %[[HEADER]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    call void @use(i1 false)
; CHECK-NEXT:    unreachable
; CHECK:       [[EXIT_CHECK]]:
; CHECK-NEXT:    br i1 true, label %[[EXIT]], label %[[TRAP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i64 [ [[N]], %[[EXIT_CHECK]] ], [ 1000, %[[THEN]] ]
; CHECK-NEXT:    ret i64 [[RES]]
