; loop is unrolled by the longer period and the swap is left alone.
define ptr @reverse_and_swap(ptr %list, ptr %x, ptr %y) {
; DEFAULT-LABEL: define ptr @reverse_and_swap(
; DEFAULT-SAME: ptr [[LIST:%.*]], ptr [[X:%.*]], ptr [[Y:%.*]]) #[[ATTR0]] {
; DEFAULT-NEXT:  [[ENTRY:.*]]:
; DEFAULT-NEXT:    br label %[[LOOP:.*]]
; DEFAULT:       [[LOOP]]:
; DEFAULT-NEXT:    [[CUR:%.*]] = phi ptr [ [[LIST]], %[[ENTRY]] ], [ [[NEXT:%.*]], %[[LOOP]] ]
; DEFAULT-NEXT:    [[PREV:%.*]] = phi ptr [ null, %[[ENTRY]] ], [ [[CUR]], %[[LOOP]] ]
; DEFAULT-NEXT:    [[FROM:%.*]] = phi ptr [ [[X]], %[[ENTRY]] ], [ [[TO:%.*]], %[[LOOP]] ]
; DEFAULT-NEXT:    [[TO]] = phi ptr [ [[Y]], %[[ENTRY]] ], [ [[FROM]], %[[LOOP]] ]
; DEFAULT-NEXT:    [[NEXT]] = load ptr, ptr [[CUR]], align 8
; DEFAULT-NEXT:    store ptr [[PREV]], ptr [[CUR]], align 8
; DEFAULT-NEXT:    store ptr [[CUR]], ptr [[FROM]], align 8
; DEFAULT-NEXT:    [[DONE:%.*]] = icmp eq ptr [[NEXT]], null
; DEFAULT-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; DEFAULT:       [[EXIT]]:
; DEFAULT-NEXT:    [[TO_LCSSA:%.*]] = phi ptr [ [[TO]], %[[LOOP]] ]
; DEFAULT-NEXT:    ret ptr [[TO_LCSSA]]
;
; CHAIN-LABEL: define ptr @reverse_and_swap(
; CHAIN-SAME: ptr [[LIST:%.*]], ptr [[X:%.*]], ptr [[Y:%.*]]) #[[ATTR0]] {
; CHAIN-NEXT:  [[ENTRY:.*]]:
; CHAIN-NEXT:    br label %[[LOOP:.*]]
; CHAIN:       [[LOOP]]:
; CHAIN-NEXT:    [[CUR:%.*]] = phi ptr [ [[LIST]], %[[ENTRY]] ], [ [[NEXT_2:%.*]], %[[LOOP_2:.*]] ]
; CHAIN-NEXT:    [[PREV:%.*]] = phi ptr [ null, %[[ENTRY]] ], [ [[NEXT_1:%.*]], %[[LOOP_2]] ]
; CHAIN-NEXT:    [[FROM:%.*]] = phi ptr [ [[X]], %[[ENTRY]] ], [ [[TO:%.*]], %[[LOOP_2]] ]
; CHAIN-NEXT:    [[TO]] = phi ptr [ [[Y]], %[[ENTRY]] ], [ [[FROM]], %[[LOOP_2]] ]
; CHAIN-NEXT:    [[NEXT:%.*]] = load ptr, ptr [[CUR]], align 8
; CHAIN-NEXT:    store ptr [[PREV]], ptr [[CUR]], align 8
; CHAIN-NEXT:    store ptr [[CUR]], ptr [[FROM]], align 8
; CHAIN-NEXT:    [[DONE:%.*]] = icmp eq ptr [[NEXT]], null
; CHAIN-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP_1:.*]]
; CHAIN:       [[LOOP_1]]:
; CHAIN-NEXT:    [[NEXT_1]] = load ptr, ptr [[NEXT]], align 8
; CHAIN-NEXT:    store ptr [[CUR]], ptr [[NEXT]], align 8
; CHAIN-NEXT:    store ptr [[NEXT]], ptr [[TO]], align 8
; CHAIN-NEXT:    [[DONE_1:%.*]] = icmp eq ptr [[NEXT_1]], null
; CHAIN-NEXT:    br i1 [[DONE_1]], label %[[EXIT]], label %[[LOOP_2]]
; CHAIN:       [[LOOP_2]]:
; CHAIN-NEXT:    [[NEXT_2]] = load ptr, ptr [[NEXT_1]], align 8
; CHAIN-NEXT:    store ptr [[NEXT]], ptr [[NEXT_1]], align 8
; CHAIN-NEXT:    store ptr [[NEXT_1]], ptr [[FROM]], align 8
; CHAIN-NEXT:    [[DONE_2:%.*]] = icmp eq ptr [[NEXT_2]], null
; CHAIN-NEXT:    br i1 [[DONE_2]], label %[[EXIT]], label %[[LOOP]]
; CHAIN:       [[EXIT]]:
; CHAIN-NEXT:    [[TO_LCSSA:%.*]] = phi ptr [ [[TO]], %[[LOOP]] ], [ [[FROM]], %[[LOOP_1]] ], [ [[TO]], %[[LOOP_2]] ]
; CHAIN-NEXT:    ret ptr [[TO_LCSSA]]
;
entry:
  br label %loop

loop:
  %cur = phi ptr [ %list, %entry ], [ %next, %loop ]
  %prev = phi ptr [ null, %entry ], [ %cur, %loop ]
  %from = phi ptr [ %x, %entry ], [ %to, %loop ]
  %to = phi ptr [ %y, %entry ], [ %from, %loop ]
  %next = load ptr, ptr %cur
  store ptr %prev, ptr %cur
  store ptr %cur, ptr %from
  %done = icmp eq ptr %next, null
  br i1 %done, label %exit, label %loop

exit:
  ret ptr %to
}

; A value that comes from outside the loop does not rotate.
define void @keep(ptr %list, ptr %x) {
; DEFAULT-LABEL: define void @keep(
; DEFAULT-SAME: ptr [[LIST:%.*]], ptr [[X:%.*]]) #[[ATTR0]] {
; DEFAULT-NEXT:  [[ENTRY:.*:]]
; DEFAULT-NEXT:    br label %[[LOOP_PEEL_BEGIN:.*]]
; DEFAULT:       [[LOOP_PEEL_BEGIN]]:
; DEFAULT-NEXT:    br label %[[LOOP_PEEL:.*]]
; DEFAULT:       [[LOOP_PEEL]]:
; DEFAULT-NEXT:    [[V_PEEL:%.*]] = load i64, ptr [[LIST]], align 8
; DEFAULT-NEXT:    store ptr null, ptr [[LIST]], align 8
; DEFAULT-NEXT:    [[DONE_PEEL:%.*]] = icmp eq i64 [[V_PEEL]], 0
; DEFAULT-NEXT:    br i1 [[DONE_PEEL]], label %[[EXIT:.*]], label %[[LOOP_PEEL_NEXT:.*]]
; DEFAULT:       [[LOOP_PEEL_NEXT]]:
; DEFAULT-NEXT:    br label %[[LOOP_PEEL2:.*]]
; DEFAULT:       [[LOOP_PEEL2]]:
; DEFAULT-NEXT:    [[V_PEEL3:%.*]] = load i64, ptr [[X]], align 8
; DEFAULT-NEXT:    store ptr [[LIST]], ptr [[X]], align 8
; DEFAULT-NEXT:    [[DONE_PEEL4:%.*]] = icmp eq i64 [[V_PEEL3]], 0
; DEFAULT-NEXT:    br i1 [[DONE_PEEL4]], label %[[EXIT]], label %[[LOOP_PEEL_NEXT1:.*]]
; DEFAULT:       [[LOOP_PEEL_NEXT1]]:
; DEFAULT-NEXT:    br label %[[LOOP_PEEL_NEXT5:.*]]
; DEFAULT:       [[LOOP_PEEL_NEXT5]]:
; DEFAULT-NEXT:    br label %[[ENTRY_PEEL_NEWPH:.*]]
; DEFAULT:       [[ENTRY_PEEL_NEWPH]]:
; DEFAULT-NEXT:    br label %[[LOOP:.*]]
; DEFAULT:       [[LOOP]]:
; DEFAULT-NEXT:    [[V:%.*]] = load i64, ptr [[X]], align 8
; DEFAULT-NEXT:    store ptr [[X]], ptr [[X]], align 8
; DEFAULT-NEXT:    [[DONE:%.*]] = icmp eq i64 [[V]], 0
; DEFAULT-NEXT:    br i1 [[DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]], !llvm.loop [[LOOP0:![0-9]+]]
; DEFAULT:       [[EXIT_LOOPEXIT]]:
; DEFAULT-NEXT:    br label %[[EXIT]]
; DEFAULT:       [[EXIT]]:
; DEFAULT-NEXT:    ret void
;
; CHAIN-LABEL: define void @keep(
; CHAIN-SAME: ptr [[LIST:%.*]], ptr [[X:%.*]]) #[[ATTR0]] {
; CHAIN-NEXT:  [[ENTRY:.*:]]
; CHAIN-NEXT:    br label %[[LOOP_PEEL_BEGIN:.*]]
; CHAIN:       [[LOOP_PEEL_BEGIN]]:
; CHAIN-NEXT:    br label %[[LOOP_PEEL:.*]]
; CHAIN:       [[LOOP_PEEL]]:
; CHAIN-NEXT:    [[V_PEEL:%.*]] = load i64, ptr [[LIST]], align 8
; CHAIN-NEXT:    store ptr null, ptr [[LIST]], align 8
; CHAIN-NEXT:    [[DONE_PEEL:%.*]] = icmp eq i64 [[V_PEEL]], 0
; CHAIN-NEXT:    br i1 [[DONE_PEEL]], label %[[EXIT:.*]], label %[[LOOP_PEEL_NEXT:.*]]
; CHAIN:       [[LOOP_PEEL_NEXT]]:
; CHAIN-NEXT:    br label %[[LOOP_PEEL2:.*]]
; CHAIN:       [[LOOP_PEEL2]]:
; CHAIN-NEXT:    [[V_PEEL3:%.*]] = load i64, ptr [[X]], align 8
; CHAIN-NEXT:    store ptr [[LIST]], ptr [[X]], align 8
; CHAIN-NEXT:    [[DONE_PEEL4:%.*]] = icmp eq i64 [[V_PEEL3]], 0
; CHAIN-NEXT:    br i1 [[DONE_PEEL4]], label %[[EXIT]], label %[[LOOP_PEEL_NEXT1:.*]]
; CHAIN:       [[LOOP_PEEL_NEXT1]]:
; CHAIN-NEXT:    br label %[[LOOP_PEEL_NEXT5:.*]]
; CHAIN:       [[LOOP_PEEL_NEXT5]]:
; CHAIN-NEXT:    br label %[[ENTRY_PEEL_NEWPH:.*]]
; CHAIN:       [[ENTRY_PEEL_NEWPH]]:
; CHAIN-NEXT:    br label %[[LOOP:.*]]
; CHAIN:       [[LOOP]]:
; CHAIN-NEXT:    [[V:%.*]] = load i64, ptr [[X]], align 8
; CHAIN-NEXT:    store ptr [[X]], ptr [[X]], align 8
; CHAIN-NEXT:    [[DONE:%.*]] = icmp eq i64 [[V]], 0
; CHAIN-NEXT:    br i1 [[DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]], !llvm.loop [[LOOP0:![0-9]+]]
; CHAIN:       [[EXIT_LOOPEXIT]]:
; CHAIN-NEXT:    br label %[[EXIT]]
; CHAIN:       [[EXIT]]:
; CHAIN-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %cur = phi ptr [ %list, %entry ], [ %x, %loop ]
  %prev = phi ptr [ null, %entry ], [ %cur, %loop ]
  %v = load i64, ptr %cur
  store ptr %prev, ptr %cur
  %done = icmp eq i64 %v, 0
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; Unrolling an outer loop would copy the inner one to save a swap.
define void @outer(ptr %p, ptr %q, i64 %n, i64 %m) {
; DEFAULT-LABEL: define void @outer(
; DEFAULT-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) #[[ATTR0]] {
; DEFAULT-NEXT:  [[ENTRY:.*]]:
; DEFAULT-NEXT:    br label %[[OUTER:.*]]
; DEFAULT:       [[OUTER]]:
; DEFAULT-NEXT:    [[A:%.*]] = phi ptr [ [[P]], %[[ENTRY]] ], [ [[B:%.*]], %[[OUTER_LATCH:.*]] ]
; DEFAULT-NEXT:    [[B]] = phi ptr [ [[Q]], %[[ENTRY]] ], [ [[A]], %[[OUTER_LATCH]] ]
; DEFAULT-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[OUTER_LATCH]] ]
; DEFAULT-NEXT:    br label %[[INNER:.*]]
; DEFAULT:       [[INNER]]:
; DEFAULT-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[OUTER]] ], [ [[I_NEXT:%.*]], %[[INNER]] ]
; DEFAULT-NEXT:    [[SRC:%.*]] = getelementptr i64, ptr [[A]], i64 [[I]]
; DEFAULT-NEXT:    [[V:%.*]] = load i64, ptr [[SRC]], align 8
; DEFAULT-NEXT:    [[DST:%.*]] = getelementptr i64, ptr [[B]], i64 [[I]]
; DEFAULT-NEXT:    store i64 [[V]], ptr [[DST]], align 8
; DEFAULT-NEXT:    [[I_NEXT]] = add i64 [[I]], 1
; DEFAULT-NEXT:    [[INNER_DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[M]]
; DEFAULT-NEXT:    br i1 [[INNER_DONE]], label %[[OUTER_LATCH]], label %[[INNER]]
; DEFAULT:       [[OUTER_LATCH]]:
; DEFAULT-NEXT:    [[J_NEXT]] = add i64 [[J]], 1
; DEFAULT-NEXT:    [[DONE:%.*]] = icmp eq i64 [[J_NEXT]], [[N]]
; DEFAULT-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[OUTER]]
; DEFAULT:       [[EXIT]]:
; DEFAULT-NEXT:    ret void
;
; CHAIN-LABEL: define void @outer(
; CHAIN-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) #[[ATTR0]] {
; CHAIN-NEXT:  [[ENTRY:.*]]:
; CHAIN-NEXT:    br label %[[OUTER:.*]]
; CHAIN:       [[OUTER]]:
; CHAIN-NEXT:    [[A:%.*]] = phi ptr [ [[P]], %[[ENTRY]] ], [ [[B:%.*]], %[[OUTER_LATCH:.*]] ]
; CHAIN-NEXT:    [[B]] = phi ptr [ [[Q]], %[[ENTRY]] ], [ [[A]], %[[OUTER_LATCH]] ]
; CHAIN-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHAIN-NEXT:    br label %[[INNER:.*]]
; CHAIN:       [[INNER]]:
; CHAIN-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[OUTER]] ], [ [[I_NEXT:%.*]], %[[INNER]] ]
; CHAIN-NEXT:    [[SRC:%.*]] = getelementptr i64, ptr [[A]], i64 [[I]]
; CHAIN-NEXT:    [[V:%.*]] = load i64, ptr [[SRC]], align 8
; CHAIN-NEXT:    [[DST:%.*]] = getelementptr i64, ptr [[B]], i64 [[I]]
; CHAIN-NEXT:    store i64 [[V]], ptr [[DST]], align 8
; CHAIN-NEXT:    [[I_NEXT]] = add i64 [[I]], 1
; CHAIN-NEXT:    [[INNER_DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[M]]
; CHAIN-NEXT:    br i1 [[INNER_DONE]], label %[[OUTER_LATCH]], label %[[INNER]]
; CHAIN:       [[OUTER_LATCH]]:
; CHAIN-NEXT:    [[J_NEXT]] = add i64 [[J]], 1
; CHAIN-NEXT:    [[DONE:%.*]] = icmp eq i64 [[J_NEXT]], [[N]]
; CHAIN-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[OUTER]]
; CHAIN:       [[EXIT]]:
; CHAIN-NEXT:    ret void
;
entry:
  br label %outer

outer:
  %a = phi ptr [ %p, %entry ], [ %b, %outer.latch ]
  %b = phi ptr [ %q, %entry ], [ %a, %outer.latch ]
  %j = phi i64 [ 0, %entry ], [ %j.next, %outer.latch ]
  br label %inner

inner:
  %i = phi i64 [ 0, %outer ], [ %i.next, %inner ]
  %src = getelementptr i64, ptr %a, i64 %i
  %v = load i64, ptr %src
  %dst = getelementptr i64, ptr %b, i64 %i
  store i64 %v, ptr %dst
  %i.next = add i64 %i, 1
  %inner.done = icmp eq i64 %i.next, %m
  br i1 %inner.done, label %outer.latch, label %inner

outer.latch:
  %j.next = add i64 %j, 1
  %done = icmp eq i64 %j.next, %n
  br i1 %done, label %exit, label %outer

exit:
  ret void
}
