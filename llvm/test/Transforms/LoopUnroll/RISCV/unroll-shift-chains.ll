; CHAIN-SAME: ptr [[LIST:%.*]], i64 [[KEY:%.*]]) #[[ATTR0]] {
; CHAIN-NEXT:  [[ENTRY:.*]]:
; CHAIN-NEXT:    br label %[[LOOP:.*]]
; CHAIN:       [[LOOP]]:
; CHAIN-NEXT:    [[CUR:%.*]] = phi ptr [ [[LIST]], %[[ENTRY]] ], [ [[NEXT:%.*]], %[[LATCH:.*]] ]
; CHAIN-NEXT:    [[FIELD:%.*]] = getelementptr inbounds i8, ptr [[CUR]], i64 8
; CHAIN-NEXT:    [[VAL:%.*]] = load i64, ptr [[FIELD]], align 8
; CHAIN-NEXT:    [[FOUND:%.*]] = icmp eq i64 [[VAL]], [[KEY]]
; CHAIN-NEXT:    br i1 [[FOUND]], label %[[EXIT:.*]], label %[[LATCH]]
; CHAIN:       [[LATCH]]:
; CHAIN-NEXT:    [[NEXT]] = load ptr, ptr [[CUR]], align 8
; CHAIN-NEXT:    [[DONE:%.*]] = icmp eq ptr [[NEXT]], null
; CHAIN-NEXT:    br i1 [[DONE]], label %[[EXIT]], label %[[LOOP]]
; CHAIN:       [[EXIT]]:
