; CHAIN-NEXT:    [[TO_EPIL_INIT:%.*]] = phi ptr [ [[DST]], %[[ENTRY]] ], [ [[TO_UNR]], %[[EXIT_UNR_LCSSA]] ]
; CHAIN-NEXT:    [[LCMP_MOD1:%.*]] = icmp ne i64 [[XTRAITER]], 0
