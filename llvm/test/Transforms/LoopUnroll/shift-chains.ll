; Searching a list compares the current node with the key before loading the
; next one, which can then take its register, so there is nothing to remove.
define ptr @find(ptr %list, ptr %key) {
; OFF-LABEL: define ptr @find(
; OFF-SAME: ptr [[LIST:%.*]], ptr [[KEY:%.*]]) {
; OFF-NEXT:  [[ENTRY:.*]]:
; OFF-NEXT:    br label %[[LOOP:.*]]
