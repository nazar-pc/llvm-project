; ON-NEXT:    [[HALF:%.*]] = lshr <2 x i32> [[V]], splat (i32 1)
; ON-NEXT:    store <2 x i32> [[V]], ptr [[OUT]], align 8
; ON-NEXT:    [[LOW:%.*]] = extractelement <2 x i32> [[HALF]], i64 0
; ON-NEXT:    [[DONE:%.*]] = icmp eq i32 [[LOW]], 0
; ON-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP_1]]
; ON:       [[LOOP_1]]:
; ON-NEXT:    [[HALF_1]] = lshr <2 x i32> [[HALF]], splat (i32 1)
; ON-NEXT:    store <2 x i32> [[HALF]], ptr [[OUT]], align 8
; ON-NEXT:    [[LOW_1:%.*]] = extractelement <2 x i32> [[HALF_1]], i64 0
; ON-NEXT:    [[DONE_1:%.*]] = icmp eq i32 [[LOW_1]], 0
; ON-NEXT:    br i1 [[DONE_1]], label %[[EXIT]], label %[[LOOP]]
; ON:       [[EXIT]]:
