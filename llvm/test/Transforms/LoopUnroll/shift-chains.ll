; Three phis rotating among themselves are a cycle, which needs a multiple of
; three.
define void @rotate(ptr %p, ptr %q, ptr %r, ptr %out) {
; OFF-LABEL: define void @rotate(
; OFF-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], ptr [[R:%.*]], ptr [[OUT:%.*]]) {
; OFF-NEXT:  [[ENTRY:.*]]:
; OFF-NEXT:    br label %[[LOOP:.*]]
; OFF:       [[LOOP]]:
; OFF-NEXT:    [[A:%.*]] = phi ptr [ [[P]], %[[ENTRY]] ], [ [[B:%.*]], %[[LOOP]] ]
; OFF-NEXT:    [[B]] = phi ptr [ [[Q]], %[[ENTRY]] ], [ [[C:%.*]], %[[LOOP]] ]
; OFF-NEXT:    [[C]] = phi ptr [ [[R]], %[[ENTRY]] ], [ [[A]], %[[LOOP]] ]
; OFF-NEXT:    [[V:%.*]] = load i64, ptr [[A]], align 4
; OFF-NEXT:    store i64 [[V]], ptr [[OUT]], align 4
; OFF-NEXT:    [[DONE:%.*]] = icmp eq i64 [[V]], 0
; OFF-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; OFF:       [[EXIT]]:
; OFF-NEXT:    ret void
;
; ON-LABEL: define void @rotate(
; ON-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], ptr [[R:%.*]], ptr [[OUT:%.*]]) {
; ON-NEXT:  [[ENTRY:.*:]]
; ON-NEXT:    br label %[[LOOP:.*]]
; ON:       [[LOOP]]:
; ON-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 4
; ON-NEXT:    store i64 [[V]], ptr [[OUT]], align 4
; ON-NEXT:    [[DONE:%.*]] = icmp eq i64 [[V]], 0
; ON-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP_1:.*]]
; ON:       [[LOOP_1]]:
; ON-NEXT:    [[V_1:%.*]] = load i64, ptr [[Q]], align 4
; ON-NEXT:    store i64 [[V_1]], ptr [[OUT]], align 4
; ON-NEXT:    [[DONE_1:%.*]] = icmp eq i64 [[V_1]], 0
; ON-NEXT:    br i1 [[DONE_1]], label %[[EXIT]], label %[[LOOP_2:.*]]
; ON:       [[LOOP_2]]:
; ON-NEXT:    [[V_2:%.*]] = load i64, ptr [[R]], align 4
; ON-NEXT:    store i64 [[V_2]], ptr [[OUT]], align 4
; ON-NEXT:    [[DONE_2:%.*]] = icmp eq i64 [[V_2]], 0
; ON-NEXT:    br i1 [[DONE_2]], label %[[EXIT]], label %[[LOOP]]
; ON:       [[EXIT]]:
; ON-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %a = phi ptr [ %p, %entry ], [ %b, %loop ]
  %b = phi ptr [ %q, %entry ], [ %c, %loop ]
  %c = phi ptr [ %r, %entry ], [ %a, %loop ]
  %v = load i64, ptr %a
  store i64 %v, ptr %out
  %done = icmp eq i64 %v, 0
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; A swap needs an even count, and a chain whose values live for three
; iterations needs at least three, so the loop is unrolled by four.
define ptr @reverse_and_swap(ptr %list, ptr %x, ptr %y) {
; OFF-LABEL: define ptr @reverse_and_swap(
; OFF-SAME: ptr [[LIST:%.*]], ptr [[X:%.*]], ptr [[Y:%.*]]) {
; OFF-NEXT:  [[ENTRY:.*]]:
; OFF-NEXT:    br label %[[LOOP:.*]]
; OFF:       [[LOOP]]:
; OFF-NEXT:    [[CUR:%.*]] = phi ptr [ [[LIST]], %[[ENTRY]] ], [ [[NEXT:%.*]], %[[LOOP]] ]
; OFF-NEXT:    [[PREV:%.*]] = phi ptr [ null, %[[ENTRY]] ], [ [[CUR]], %[[LOOP]] ]
; OFF-NEXT:    [[FROM:%.*]] = phi ptr [ [[X]], %[[ENTRY]] ], [ [[TO:%.*]], %[[LOOP]] ]
; OFF-NEXT:    [[TO]] = phi ptr [ [[Y]], %[[ENTRY]] ], [ [[FROM]], %[[LOOP]] ]
; OFF-NEXT:    [[NEXT]] = load ptr, ptr [[CUR]], align 8
; OFF-NEXT:    store ptr [[PREV]], ptr [[CUR]], align 8
; OFF-NEXT:    store ptr [[CUR]], ptr [[FROM]], align 8
; OFF-NEXT:    [[DONE:%.*]] = icmp eq ptr [[NEXT]], null
; OFF-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; OFF:       [[EXIT]]:
; OFF-NEXT:    [[TO_LCSSA:%.*]] = phi ptr [ [[TO]], %[[LOOP]] ]
; OFF-NEXT:    ret ptr [[TO_LCSSA]]
;
; ON-LABEL: define ptr @reverse_and_swap(
; ON-SAME: ptr [[LIST:%.*]], ptr [[X:%.*]], ptr [[Y:%.*]]) {
; ON-NEXT:  [[ENTRY:.*]]:
; ON-NEXT:    br label %[[LOOP:.*]]
; ON:       [[LOOP]]:
; ON-NEXT:    [[CUR:%.*]] = phi ptr [ [[LIST]], %[[ENTRY]] ], [ [[NEXT_3:%.*]], %[[LOOP_3:.*]] ]
; ON-NEXT:    [[PREV:%.*]] = phi ptr [ null, %[[ENTRY]] ], [ [[NEXT_2:%.*]], %[[LOOP_3]] ]
; ON-NEXT:    [[NEXT:%.*]] = load ptr, ptr [[CUR]], align 8
; ON-NEXT:    store ptr [[PREV]], ptr [[CUR]], align 8
; ON-NEXT:    store ptr [[CUR]], ptr [[X]], align 8
; ON-NEXT:    [[DONE:%.*]] = icmp eq ptr [[NEXT]], null
; ON-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP_1:.*]]
; ON:       [[LOOP_1]]:
; ON-NEXT:    [[NEXT_1:%.*]] = load ptr, ptr [[NEXT]], align 8
; ON-NEXT:    store ptr [[CUR]], ptr [[NEXT]], align 8
; ON-NEXT:    store ptr [[NEXT]], ptr [[Y]], align 8
; ON-NEXT:    [[DONE_1:%.*]] = icmp eq ptr [[NEXT_1]], null
; ON-NEXT:    br i1 [[DONE_1]], label %[[EXIT]], label %[[LOOP_2:.*]]
; ON:       [[LOOP_2]]:
; ON-NEXT:    [[NEXT_2]] = load ptr, ptr [[NEXT_1]], align 8
; ON-NEXT:    store ptr [[NEXT]], ptr [[NEXT_1]], align 8
; ON-NEXT:    store ptr [[NEXT_1]], ptr [[X]], align 8
; ON-NEXT:    [[DONE_2:%.*]] = icmp eq ptr [[NEXT_2]], null
; ON-NEXT:    br i1 [[DONE_2]], label %[[EXIT]], label %[[LOOP_3]]
; ON:       [[LOOP_3]]:
; ON-NEXT:    [[NEXT_3]] = load ptr, ptr [[NEXT_2]], align 8
; ON-NEXT:    store ptr [[NEXT_1]], ptr [[NEXT_2]], align 8
; ON-NEXT:    store ptr [[NEXT_2]], ptr [[Y]], align 8
; ON-NEXT:    [[DONE_3:%.*]] = icmp eq ptr [[NEXT_3]], null
; ON-NEXT:    br i1 [[DONE_3]], label %[[EXIT]], label %[[LOOP]]
; ON:       [[EXIT]]:
; ON-NEXT:    [[TO_LCSSA:%.*]] = phi ptr [ [[Y]], %[[LOOP]] ], [ [[X]], %[[LOOP_1]] ], [ [[Y]], %[[LOOP_2]] ], [ [[X]], %[[LOOP_3]] ]
; ON-NEXT:    ret ptr [[TO_LCSSA]]
;
entry:
  br label %loop

loop:
  %cur = phi ptr [ %list, %entry ], [ %next, %loop ]
  %prev = phi ptr [ null, %entry ], [ %cur, %loop ]
  %from = phi ptr [ %x, %entry ], [ %to, %loop ]
  %to = phi ptr [ %y, %entry ], [ %from, %loop ]
  %next = load ptr, ptr %cur
  store ptr %prev, ptr %cur
  store ptr %cur, ptr %from
  %done = icmp eq ptr %next, null
  br i1 %done, label %exit, label %loop

exit:
  ret ptr %to
}

