; OFF-NEXT:    [[K_NEXT_LCSSA:%.*]] = phi i32 [ [[K_NEXT]], %[[LOOP]] ]
; OFF-NEXT:    ret i32 [[K_NEXT_LCSSA]]
;
; ON-LABEL: define i32 @count_trailing_zeros(
; ON-SAME: i32 [[X:%.*]]) {
; ON-NEXT:  [[ENTRY:.*]]:
; ON-NEXT:    br label %[[LOOP:.*]]
; ON:       [[LOOP]]:
; ON-NEXT:    [[K:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[K_NEXT:%.*]], %[[LOOP]] ]
; ON-NEXT:    [[D:%.*]] = phi i32 [ [[X]], %[[ENTRY]] ], [ [[D_NEXT:%.*]], %[[LOOP]] ]
; ON-NEXT:    [[D_NEXT]] = lshr i32 [[D]], 1
; ON-NEXT:    [[K_NEXT]] = add i32 [[K]], 1
; ON-NEXT:    [[BIT:%.*]] = and i32 [[D]], 2
