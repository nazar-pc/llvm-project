; ON-NEXT:    [[V_EPIL]] = load i64, ptr [[ADDR_EPIL]], align 4
; ON-NEXT:    store i64 [[PREV_EPIL]], ptr [[ADDR_EPIL]], align 4
; ON-NEXT:    [[I_NEXT_EPIL]] = add nuw i64 [[I_EPIL]], 1
; ON-NEXT:    [[DONE_EPIL:%.*]] = icmp eq i64 [[I_NEXT_EPIL]], [[N]]
; ON-NEXT:    [[EPIL_ITER_NEXT]] = add i64 [[EPIL_ITER]], 1
; ON-NEXT:    [[EPIL_ITER_CMP:%.*]] = icmp ne i64 [[EPIL_ITER_NEXT]], [[XTRAITER]]
