; ON-LABEL: define void @outer(
; ON-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; ON-NEXT:  [[ENTRY:.*]]:
; ON-NEXT:    br label %[[OUTER:.*]]
; ON:       [[OUTER]]:
; ON-NEXT:    [[A:%.*]] = phi ptr [ [[P]], %[[ENTRY]] ], [ [[B:%.*]], %[[OUTER_LATCH:.*]] ]
; ON-NEXT:    [[B]] = phi ptr [ [[Q]], %[[ENTRY]] ], [ [[A]], %[[OUTER_LATCH]] ]
; ON-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[OUTER_LATCH]] ]
