; ON-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; ON-NEXT:    [[I_NEXT]] = add nuw i64 [[I]], 1
; ON-NEXT:    [[ADDR:%.*]] = getelementptr inbounds i64, ptr [[P]], i64 [[I]]
; ON-NEXT:    store i64 [[I]], ptr [[ADDR]], align 4
; ON-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; ON-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
