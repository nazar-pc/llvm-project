; OFF-NEXT:    [[V:%.*]] = load i64, ptr [[SRC]], align 4
; OFF-NEXT:    [[DST:%.*]] = getelementptr i64, ptr [[B]], i64 [[I]]
; OFF-NEXT:    store i64 [[V]], ptr [[DST]], align 4
