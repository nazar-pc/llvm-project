; OFF-NEXT:    br i1 [[INNER_DONE]], label %[[OUTER_LATCH]], label %[[INNER]]
; OFF:       [[OUTER_LATCH]]:
; OFF-NEXT:    [[J_NEXT]] = add i64 [[J]], 1
; OFF-NEXT:    [[DONE:%.*]] = icmp eq i64 [[J_NEXT]], [[N]]
; OFF-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[OUTER]]
; OFF:       [[EXIT]]:
; OFF-NEXT:    ret void
