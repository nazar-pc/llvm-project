; ON-NEXT:    [[SRC:%.*]] = getelementptr i64, ptr [[A]], i64 [[I]]
; ON-NEXT:    [[V:%.*]] = load i64, ptr [[SRC]], align 4
; ON-NEXT:    [[DST:%.*]] = getelementptr i64, ptr [[B]], i64 [[I]]
; ON-NEXT:    store i64 [[V]], ptr [[DST]], align 4
; ON-NEXT:    [[I_NEXT]] = add i64 [[I]], 1
; ON-NEXT:    [[INNER_DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[M]]
; ON-NEXT:    br i1 [[INNER_DONE]], label %[[OUTER_LATCH]], label %[[INNER]]
; ON:       [[OUTER_LATCH]]:
; ON-NEXT:    [[J_NEXT]] = add i64 [[J]], 1
