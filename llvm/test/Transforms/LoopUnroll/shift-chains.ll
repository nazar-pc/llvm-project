; OFF-NEXT:    [[CUR:%.*]] = phi ptr [ [[LIST]], %[[ENTRY]] ], [ [[NEXT:%.*]], %[[LATCH:.*]] ]
; OFF-NEXT:    [[FOUND:%.*]] = icmp eq ptr [[CUR]], [[KEY]]
; OFF-NEXT:    br i1 [[FOUND]], label %[[EXIT:.*]], label %[[LATCH]]
; OFF:       [[LATCH]]:
; OFF-NEXT:    [[NEXT]] = load ptr, ptr [[CUR]], align 8
; OFF-NEXT:    [[DONE:%.*]] = icmp eq ptr [[NEXT]], null
; OFF-NEXT:    br i1 [[DONE]], label %[[EXIT]], label %[[LOOP]]
; OFF:       [[EXIT]]:
; OFF-NEXT:    [[RESULT:%.*]] = phi ptr [ [[CUR]], %[[LOOP]] ], [ null, %[[LATCH]] ]
; OFF-NEXT:    ret ptr [[RESULT]]
;
; ON-LABEL: define ptr @find(
; ON-SAME: ptr [[LIST:%.*]], ptr [[KEY:%.*]]) {
; ON-NEXT:  [[ENTRY:.*]]:
; ON-NEXT:    br label %[[LOOP:.*]]
; ON:       [[LOOP]]:
; ON-NEXT:    [[CUR:%.*]] = phi ptr [ [[LIST]], %[[ENTRY]] ], [ [[NEXT:%.*]], %[[LATCH:.*]] ]
; ON-NEXT:    [[FOUND:%.*]] = icmp eq ptr [[CUR]], [[KEY]]
; ON-NEXT:    br i1 [[FOUND]], label %[[EXIT:.*]], label %[[LATCH]]
; ON:       [[LATCH]]:
; ON-NEXT:    [[NEXT]] = load ptr, ptr [[CUR]], align 8
; ON-NEXT:    [[DONE:%.*]] = icmp eq ptr [[NEXT]], null
; ON-NEXT:    br i1 [[DONE]], label %[[EXIT]], label %[[LOOP]]
; ON:       [[EXIT]]:
; ON-NEXT:    [[RESULT:%.*]] = phi ptr [ [[CUR]], %[[LOOP]] ], [ null, %[[LATCH]] ]
; ON-NEXT:    ret ptr [[RESULT]]
;
entry:
  br label %loop

loop:
  %cur = phi ptr [ %list, %entry ], [ %next, %latch ]
  %found = icmp eq ptr %cur, %key
  br i1 %found, label %exit, label %latch

latch:
  %next = load ptr, ptr %cur
  %done = icmp eq ptr %next, null
  br i1 %done, label %exit, label %loop

exit:
  %result = phi ptr [ %cur, %loop ], [ null, %latch ]
  ret ptr %result
}

