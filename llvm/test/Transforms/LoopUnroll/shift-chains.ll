; ON-NEXT:    [[W:%.*]] = add i64 [[V]], 1
; ON-NEXT:    store i64 [[W]], ptr [[DST]], align 4
; ON-NEXT:    [[V_1:%.*]] = load i64, ptr [[DST]], align 4
; ON-NEXT:    [[W_1:%.*]] = add i64 [[V_1]], 1
; ON-NEXT:    store i64 [[W_1]], ptr [[SRC]], align 4
; ON-NEXT:    [[I_NEXT_1]] = add nuw i64 [[I]], 2
; ON-NEXT:    [[NITER_NEXT_1]] = add i64 [[NITER]], 2
; ON-NEXT:    [[NITER_NCMP_1:%.*]] = icmp eq i64 [[NITER_NEXT_1]], [[UNROLL_ITER]]
; ON-NEXT:    br i1 [[NITER_NCMP_1]], label %[[EXIT_UNR_LCSSA:.*]], label %[[LOOP]]
; ON:       [[EXIT_UNR_LCSSA]]:
; ON-NEXT:    [[FROM_UNR:%.*]] = phi ptr [ [[SRC]], %[[LOOP]] ]
; ON-NEXT:    [[TO_UNR:%.*]] = phi ptr [ [[DST]], %[[LOOP]] ]
; ON-NEXT:    [[LCMP_MOD:%.*]] = icmp ne i64 [[XTRAITER]], 0
; ON-NEXT:    br i1 [[LCMP_MOD]], label %[[LOOP_EPIL_PREHEADER]], label %[[EXIT:.*]]
; ON:       [[LOOP_EPIL_PREHEADER]]:
; ON-NEXT:    [[FROM_EPIL_INIT:%.*]] = phi ptr [ [[SRC]], %[[ENTRY]] ], [ [[FROM_UNR]], %[[EXIT_UNR_LCSSA]] ]
; ON-NEXT:    [[TO_EPIL_INIT:%.*]] = phi ptr [ [[DST]], %[[ENTRY]] ], [ [[TO_UNR]], %[[EXIT_UNR_LCSSA]] ]
; ON-NEXT:    [[LCMP_MOD1:%.*]] = icmp ne i64 [[XTRAITER]], 0
; ON-NEXT:    call void @llvm.assume(i1 [[LCMP_MOD1]])
; ON-NEXT:    br label %[[LOOP_EPIL:.*]]
