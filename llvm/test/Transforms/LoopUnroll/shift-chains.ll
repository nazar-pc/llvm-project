; OFF-NEXT:    [[HALF]] = lshr <2 x i32> [[V]], splat (i32 1)
; OFF-NEXT:    store <2 x i32> [[V]], ptr [[OUT]], align 8
; OFF-NEXT:    [[LOW:%.*]] = extractelement <2 x i32> [[HALF]], i64 0
; OFF-NEXT:    [[DONE:%.*]] = icmp eq i32 [[LOW]], 0
; OFF-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; OFF:       [[EXIT]]:
; OFF-NEXT:    [[HALF_LCSSA:%.*]] = phi <2 x i32> [ [[HALF]], %[[LOOP]] ]
; OFF-NEXT:    ret <2 x i32> [[HALF_LCSSA]]
;
; ON-LABEL: define <2 x i32> @halve(
