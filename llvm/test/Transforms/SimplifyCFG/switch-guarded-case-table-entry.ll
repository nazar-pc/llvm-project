; Indirect call promotion does not leave the common destination as a bare
; indirect call: it leaves it testing the phi against the target it promoted,
; and the specialized case reaches a copy of the side that test selects. The phi
; is already gone there, so the value it would have held is the one the test
; names. Without this the slot keeps a filler, and copies of one dispatch that
; guard different cases produce tables that differ only in the byte nothing
; reads -- which is exactly what stops them merging.

define i64 @icp_residual_compare(i8 %op, ptr %arg) {
; CHECK-LABEL: define i64 @icp_residual_compare(
; CHECK-SAME: i8 [[OP:%.*]], ptr [[ARG:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[COND:%.*]] = icmp eq i8 [[OP]], 1
; CHECK-NEXT:    br i1 [[COND]], label %[[DIRECT:.*]], label %[[ENTRY_LOOKUP:.*]]
; CHECK:       [[ENTRY_LOOKUP]]:
; CHECK-NEXT:    [[TMP0:%.*]] = icmp ult i8 [[OP]], 6
; CHECK-NEXT:    br i1 [[TMP0]], label %[[SWITCH_LOOKUP:.*]], label %[[JOIN:.*]]
; CHECK:       [[COMMON_RET:.*]]:
; CHECK-NEXT:    [[COMMON_RET_OP:%.*]] = phi i64 [ [[D:%.*]], %[[DIRECT]] ], [ [[R1:%.*]], %[[ICP_DIRECT:.*]] ], [ [[R2:%.*]], %[[ICP_INDIRECT:.*]] ]
; CHECK-NEXT:    ret i64 [[COMMON_RET_OP]]
; CHECK:       [[DIRECT]]:
; CHECK-NEXT:    [[D]] = call i64 @h1(ptr [[ARG]])
; CHECK-NEXT:    br label %[[COMMON_RET]]
; CHECK:       [[SWITCH_LOOKUP]]:
; CHECK-NEXT:    [[TMP1:%.*]] = zext nneg i8 [[OP]] to i64
; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds [6 x ptr], ptr @switch.table.icp_residual_compare, i64 0, i64 [[TMP1]]
; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load ptr, ptr [[SWITCH_GEP]], align 8
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[H:%.*]] = phi ptr [ [[SWITCH_LOAD]], %[[SWITCH_LOOKUP]] ], [ @hd, %[[ENTRY_LOOKUP]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq ptr [[H]], @h1
; CHECK-NEXT:    br i1 [[CMP]], label %[[ICP_DIRECT]], label %[[ICP_INDIRECT]]
; CHECK:       [[ICP_DIRECT]]:
; CHECK-NEXT:    [[R1]] = call i64 @h1(ptr [[ARG]])
; CHECK-NEXT:    br label %[[COMMON_RET]]
; CHECK:       [[ICP_INDIRECT]]:
; CHECK-NEXT:    [[R2]] = call i64 [[H]](ptr [[ARG]])
; CHECK-NEXT:    br label %[[COMMON_RET]]
;
entry:
  switch i8 %op, label %def [
  i8 0, label %c0
  i8 1, label %direct
  i8 2, label %c2
  i8 3, label %c3
  i8 4, label %c4
  i8 5, label %c5
  ]

c0:
  br label %join
c2:
  br label %join
c3:
  br label %join
c4:
  br label %join
c5:
  br label %join
def:
  br label %join

direct:
  %d = call i64 @h1(ptr %arg)
  ret i64 %d

join:
  %h = phi ptr [ @h0, %c0 ], [ @h2, %c2 ], [ @h3, %c3 ], [ @h4, %c4 ], [ @h5, %c5 ], [ @hd, %def ]
  %cmp = icmp eq ptr %h, @h1
  br i1 %cmp, label %icp.direct, label %icp.indirect

icp.direct:
  %r1 = call i64 @h1(ptr %arg)
  ret i64 %r1

icp.indirect:
